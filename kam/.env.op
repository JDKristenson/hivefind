# 1Password references only. Never a literal value. Resolved at runtime by `op run --env-file kam/.env.op`.
# Phase 0/1: items live in vault KAM (a custom vault; service accounts cannot read built-in vaults). Phase 2: per-agent vaults (kam-xavier, kam-evelyn, kam-codex).
KAM_DB_DSN=op://KAM/KAM Supabase kam_writer/dsn
OPENROUTER_API_KEY=op://KAM/OpenRouter/credential
NOTION_TOKEN=op://KAM/KAM Notion integration/credential
