[Unit]
Description=KAM kam ledger (weekly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
Environment=HOME=/home/ec2-user
Environment=PATH=/home/ec2-user/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KAM_HOST=ec2
Environment=KAM_SKIP_OP=1
WorkingDirectory=/home/ec2-user/hivefind
ExecStart=/bin/bash -lc 'kam ledger && kam heartbeat kam-ledger'
TimeoutStartSec=900
